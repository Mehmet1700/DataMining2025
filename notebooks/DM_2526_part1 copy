     "execution_count": 35,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "customers = customers.copy()   # <-- crucial to avoid SettingWithCopyWarning\n",
    "\n",
    "# New column \"IsActive\": 1 if CancellationDate is NaN, else 0\n",
    "customers[\"IsActive\"] = customers[\"CancellationDate\"].isna().astype(int)\n",
    "# percentage distribution\n",
    "customers[\"IsActive\"].value_counts(normalize=True).round(3) * 100"

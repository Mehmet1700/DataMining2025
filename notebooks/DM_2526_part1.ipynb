   "source": [
    "## 5.2 Behavioral Segmentation    <a class=\"anchor\" id=\"Flights-EDA\"></a>\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "22f3f471",
   "metadata": {},
   "source": [
    "In this Section we look into some insights about the behaviour. This for example includes behaviour of the customers in the months. "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3631edb3",
   "metadata": {},
   "source": [
    "### 5.2.1 Seasonal Analysis <a class=\"anchor\" id=\"Customer Lifetime Value\"></a>\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bd72f188",
   "metadata": {},
   "source": [
    "Some text as explanation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 86,
   "id": "da627c54",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Count the NumFlights per Month for each year \n",
    "monthly_flight_counts = flights.groupby(['Year', 'Month'])['NumFlights'].sum().reset_index()\n",
    "\n",
    "# Plot the monthly flight counts for each year\n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.lineplot(\n",
    "    data=monthly_flight_counts,\n",
    "    x='Month',\n",
    "    y='NumFlights',\n",
    "    hue='Year',\n",
    "    marker='o'\n",
    ")\n",
    "plt.title('Monthly Flight Counts by Year')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Total Number of Flights')\n",
    "plt.xticks(range(1, 13))\n",
    "plt.legend(title='Year')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 90,
   "id": "e318f02e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Count the NumFlights per Month for each year \n",
    "monthly_flight_counts = (\n",
    "    flights.groupby(['Year', 'Month'])['NumFlights']\n",
    "    .sum()\n",
    "    .reset_index()\n",
    "    .sort_values(['Year', 'Month'])\n",
    ")\n",
    "\n",
    "# --- Plot: Grouped Bar Chart ---\n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.set(style=\"whitegrid\")\n",
    "\n",
    "sns.barplot(\n",
    "    data=monthly_flight_counts,\n",
    "    x='Month',\n",
    "    y='NumFlights',\n",
    "    hue='Year',\n",
    "    palette='viridis'\n",
    ")\n",
    "\n",
    "\n",
    "plt.title('Monthly Flight Counts by Year', fontsize=16, fontweight='bold')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Total Number of Flights')\n",
    "plt.xticks(range(0, 12), [str(i+1) for i in range(12)])  # months 1–12\n",
    "plt.legend(title='Year', loc='upper left', bbox_to_anchor=(1, 1))\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 88,
   "id": "ce5622ae",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Count the NumFlights per Season for each year\n",
    "seasonal_flight_counts = (\n",
    "    flights.groupby(['Year', 'Season'])['NumFlights']\n",
    "    .sum()\n",
    "    .reset_index()\n",
    "    .sort_values(['Year', 'Season'])\n",
    ")\n",
    "\n",
    "# Define season order (optional, to keep logical order)\n",
    "season_order = ['Winter', 'Spring', 'Summer', 'Autumn']\n",
    "\n",
    "# --- Plot: Grouped Bar Chart by Season ---\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.set(style=\"whitegrid\")\n",
    "\n",
    "sns.barplot(\n",
    "    data=seasonal_flight_counts,\n",
    "    x='Season',\n",
    "    y='NumFlights',\n",
    "    hue='Year',\n",
    "    palette='viridis',\n",
    "    order=season_order\n",
    ")\n",
    "\n",
    "# Add small value labels on top of bars\n",
    "for container in plt.gca().containers:\n",
    "    plt.bar_label(container, fmt='%d', label_type='edge', fontsize=8, padding=2)\n",
    "\n",
    "plt.title('Seasonal Flight Counts by Year', fontsize=16, fontweight='bold')\n",
    "plt.xlabel('Season')\n",
    "plt.ylabel('Total Number of Flights')\n",
    "plt.legend(title='Year', loc='upper left', bbox_to_anchor=(1, 1))\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
